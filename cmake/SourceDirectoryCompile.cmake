# Compiler launcher (CMAKE_<LANG>_COMPILER_LAUNCHER) for Visual C++: compiles a source in its own directory under its
# file name alone, the way the Visual C++ 7.0 project build names it. The compiler's __FILE__ is the source name as
# written on the command line, so it is "file.cpp" instead of the absolute path a CMake build passes.
#
#   cmake -P SourceDirectoryCompile.cmake -- <compiler> <argument>...
#
# Arguments may come in response files (@file, the NMake generator's inline files). The outputs the build names
# relative to its own directory (/Fo, /Fd) and the automatic precompiled header (/YX, vc70.pch in that directory)
# keep their places.

set(build_dir "${CMAKE_CURRENT_BINARY_DIR}")
set(compiler "")
set(text "")
set(seen_separator FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(i RANGE ${last})
  set(arg "${CMAKE_ARGV${i}}")
  if(NOT seen_separator)
    if(arg STREQUAL "--")
      set(seen_separator TRUE)
    endif()
  elseif(compiler STREQUAL "")
    set(compiler "${arg}")
  elseif(arg MATCHES "^@(.+)$")
    file(READ "${CMAKE_MATCH_1}" contents)
    string(APPEND text " ${contents}")
  elseif(arg MATCHES "[ \t]")
    string(APPEND text " \"${arg}\"")
  else()
    string(APPEND text " ${arg}")
  endif()
endforeach()
string(REGEX REPLACE "[\r\n]+" " " text "${text}")

if(NOT text MATCHES "[ \t]-c[ \t]+(\"[^\"]+\"|[^ \t\"]+)[ \t]*$")
  message(FATAL_ERROR "SourceDirectoryCompile: no source file at the end of the command line:${text}")
endif()
set(source_arg "${CMAKE_MATCH_1}")
string(REPLACE "\"" "" source "${source_arg}")
file(TO_CMAKE_PATH "${source}" source)
get_filename_component(source_dir "${source}" DIRECTORY)
get_filename_component(source_name "${source}" NAME)
string(FIND "${text}" "${source_arg}" at REVERSE)
string(SUBSTRING "${text}" 0 ${at} text)
string(APPEND text "${source_name}")

# Outputs named relative to the build directory.
string(REGEX MATCHALL "[ \t]/F[od][^ \t\"]+" outputs "${text}")
foreach(option IN LISTS outputs)
  string(REGEX REPLACE "^[ \t]/F[od]" "" path "${option}")
  if(NOT IS_ABSOLUTE "${path}")
    string(SUBSTRING "${option}" 0 4 switch)
    file(TO_NATIVE_PATH "${build_dir}/${path}" native)
    string(REPLACE "${option}" "${switch}${native}" text "${text}")
  endif()
endforeach()
if(text MATCHES "[ \t]/YX" AND NOT text MATCHES "[ \t]/Fp")
  file(TO_NATIVE_PATH "${build_dir}/vc70.pch" native)
  string(APPEND text " /Fp${native}")
endif()

if(NOT text MATCHES "[ \t]/Fo([^ \t\"]+)")
  message(FATAL_ERROR "SourceDirectoryCompile: no /Fo on the command line:${text}")
endif()
set(response "${CMAKE_MATCH_1}")
if(response MATCHES "[\\/]$")
  string(APPEND response "${source_name}")
endif()
file(TO_CMAKE_PATH "${response}.rsp" response)
file(WRITE "${response}" "${text}\n")
execute_process(COMMAND "${compiler}" "@${response}" WORKING_DIRECTORY "${source_dir}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  cmake_language(EXIT 1)
endif()
